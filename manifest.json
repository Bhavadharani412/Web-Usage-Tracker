{
  "manifest_version": 3,
  "name": "WebTrack — Usage Tracker & Tab Cleanup",
  "short_name": "WebTrack",
  "version": "0.1.0",
  "description": "Understand your web time. Clean up your tabs. Privacy-first active usage tracking with intelligent tab cleanup suggestions.",

  "permissions": [
    "tabs",
    "storage",
    "idle",
    "alarms"
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "webtrack@local-dev",
      "strict_min_version": "115.0"
    }
  },

  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },

  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    },
    "default_title": "WebTrack"
  },

  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },

  "options_page": "src/dashboard/index.html"
}
